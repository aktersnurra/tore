#!/usr/bin/env sh
set -eu

# First run: seed .env and stop so the user fills in creds before anything uses them.
if [ ! -f .env ]; then
  cp .env.example .env
  echo "Created .env from .env.example. Fill in GARAGE_* creds + API keys, then re-run bin/dev."
  exit 1
fi

# Load env FIRST — the bootstrap imports GARAGE_ACCESS_KEY_ID/SECRET into Garage.
set -a
. ./.env
set +a

# pi runs every AI task (import, chat, pictures), so it's on unless TORE_PI_COMMAND says otherwise.
: "${TORE_PI_COMMAND:=harness/pi-session}"
export TORE_PI_COMMAND

# Model keys .env leaves out come from pass, when there is one: the entries are
# TORE_PASS_ANTHROPIC and TORE_PASS_OPENROUTER, or these defaults.
if command -v pass >/dev/null 2>&1; then
  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    ANTHROPIC_API_KEY=$(pass show "${TORE_PASS_ANTHROPIC:-claude/api-key-tore}" 2>/dev/null | head -n 1 || true)
  fi
  if [ -z "${OPENROUTER_API_KEY:-}" ]; then
    OPENROUTER_API_KEY=$(pass show "${TORE_PASS_OPENROUTER:-openrouter_api_key}" 2>/dev/null | head -n 1 || true)
  fi
  export ANTHROPIC_API_KEY OPENROUTER_API_KEY
fi

# Bring up Garage and BLOCK until its healthcheck passes (no sleep, no poll loop).
docker compose up -d --wait

# Provision once / no-op on subsequent runs (imports .env creds, makes the bucket).
./bin/garage-bootstrap.sh

exec mix phx.server
