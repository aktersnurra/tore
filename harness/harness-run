#!/bin/sh
# Runs one harness job and prints one result, the way `serai --json` does. Tore calls it with the
# job on stdin, directly on the same machine or as the forced command of an ssh key on the guest.
#
#   in:  {"job": "42", "household": 7, "task": "plan_week", "mcp_url": "https://…/mcp",
#         "token": "…", "model": "claude-sonnet-5-5", "timeout_s": 900, "max_budget_usd": 1.0}
#   out: {"status": "succeeded" | "failed" | "timed_out", "summary": "…", "cost_usd": 0.05,
#         "tokens": {"input": 81234, "output": 5120}, "transcript": "/…/42.jsonl"}
#
# A job that can't run is a "failed" result with the reason as its summary, not an exit code, so
# Tore records why. One job per household at a time: a second is refused, not queued.
#
# Needs jq, flock, timeout and the harness (HARNESS=claude, the default). Claude Code needs
# ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN in the environment. Transcripts and locks live in
# HARNESS_STATE_DIR (default ~/.local/state/tore-harness).
#
# The household agent gets none of this machine's own Claude settings: an empty config dir and a
# copy of AGENTS.md and the tasks in a fresh directory, so no CLAUDE.md is found above it. Not
# --bare: that mode has no web tools.
set -eu

dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
state=${HARNESS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tore-harness}
job=$(cat)

result() { # status summary
  jq -cn --arg status "$1" --arg summary "$2" '{status: $status, summary: $summary, cost_usd: 0}'
}
refuse() { result failed "$1"; exit 0; }
field() { printf '%s' "$job" | jq -r "$1 // empty" 2>/dev/null; }

id=$(field .job)
household=$(field .household)
task=$(field .task)
mcp_url=$(field .mcp_url)
token=$(field .token)
model=$(field .model)
timeout_s=$(field .timeout_s)
budget=$(field .max_budget_usd)

case $id in '' | *[!A-Za-z0-9_-]*) refuse "bad job id" ;; esac
case $household in '' | *[!0-9]*) refuse "bad household" ;; esac
case $task in '' | *[!a-z_]*) refuse "bad task" ;; esac
[ -f "$dir/tasks/$task.md" ] || refuse "no task $task"
[ -n "$mcp_url" ] && [ -n "$token" ] || refuse "no mcp_url or token"
case ${timeout_s:=900} in *[!0-9]*) refuse "bad timeout_s" ;; esac

mkdir -p "$state/jobs"
exec 9>"$state/household-$household.lock"
flock -n 9 || refuse "another job is running for household $household"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
transcript="$state/jobs/$id.jsonl"

# The token goes in a file only this user can read, not on the command line.
(umask 077 && jq -cn --arg url "$mcp_url" --arg token "$token" \
  '{mcpServers: {tore: {type: "http", url: $url, headers: {Authorization: ("Bearer " + $token)}}}}' \
  >"$work/mcp.json")
mkdir "$work/config" "$work/harness"
cp -R "$dir/AGENTS.md" "$dir/tasks" "$work/harness/"
cd "$work/harness"

case ${HARNESS:-claude} in
claude)
  [ -n "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}" ] ||
    refuse "no ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN on the harness machine"
  set +e
  CLAUDE_CONFIG_DIR="$work/config" timeout "$timeout_s" claude -p "$(cat "tasks/$task.md")" \
    --append-system-prompt-file AGENTS.md \
    --mcp-config "$work/mcp.json" --strict-mcp-config \
    --tools WebSearch,WebFetch \
    --allowedTools mcp__tore WebSearch WebFetch \
    ${model:+--model "$model"} \
    ${budget:+--max-budget-usd "$budget"} \
    --no-session-persistence \
    --output-format stream-json --verbose >"$transcript" 2>"$work/stderr"
  code=$?
  set -e
  ;;
*) refuse "no adapter for HARNESS=${HARNESS}" ;;
esac

# Claude Code's last line is its result: whether it finished, its summary, and what it cost.
last=$(tail -n 1 "$transcript")
if printf '%s' "$last" | jq -e '.type == "result"' >/dev/null 2>&1; then
  printf '%s' "$last" | jq -c --arg transcript "$transcript" --argjson code "$code" '{
    status: (if $code == 124 then "timed_out" elif .subtype == "success" then "succeeded"
             else "failed" end),
    summary: (.result // .subtype),
    cost_usd: (.total_cost_usd // 0),
    tokens: {input: ((.usage.input_tokens // 0) + (.usage.cache_read_input_tokens // 0)
                     + (.usage.cache_creation_input_tokens // 0)),
             output: (.usage.output_tokens // 0)},
    transcript: $transcript}'
elif [ "$code" -eq 124 ]; then
  result timed_out "stopped after ${timeout_s} s"
else
  result failed "claude exited $code: $(tail -c 500 "$work/stderr")"
fi
